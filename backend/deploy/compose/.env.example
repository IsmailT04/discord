# Used by docker compose in this directory (make up / make signoz-up).
# Copy to .env:  cp backend/deploy/compose/.env.example backend/deploy/compose/.env
#
# Keep these values in sync with backend/.env DB_* and REDIS_* so the host API
# can reach the published container ports.

POSTGRES_USER=discord
POSTGRES_PASSWORD=discord_dev_password
POSTGRES_DB=discord_db
POSTGRES_PORT=5432

REDIS_PASSWORD=discord_redis_password
REDIS_PORT=6379
