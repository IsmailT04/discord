# ==============================================================================
# Platform — Server & Environment
# ==============================================================================
APP_ENV=development                # development | staging | production
APP_PORT=8080                      # Go HTTP/WS server port
APP_BASE_URL=http://localhost:8080 # Public URL of the backend

# ==============================================================================
# Platform — Databases & Cache (Host connecting to Docker ports)
# ==============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=discord
DB_PASSWORD=discord_dev_password
DB_NAME=discord_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=15m

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==============================================================================
# Identity — Auth & Cookies
# ==============================================================================
# Generate a strong 32-byte secret for signing/encrypting (e.g., openssl rand -base64 32)
COOKIE_SECRET=change-me-to-a-secure-random-key-32bytes!!
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false                # Set 'true' in prod (HTTPS)
ACCESS_TOKEN_TTL=15m               # Short-lived access cookie
REFRESH_TOKEN_TTL=168h             # 7 days refresh cookie
CSRF_SECRET=change-me-to-another-secure-key-32bytes!!

# ==============================================================================
# Chat — File Upload Limits (Postgres BYTEA)
# ==============================================================================
MAX_ATTACHMENT_SIZE_BYTES=5242880  # 5 MB
ALLOWED_ATTACHMENT_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf

# ==============================================================================
# Media — LiveKit Server Integration
# ==============================================================================
LIVEKIT_HOST=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretsecretsecretsecretsecretsecret

# ==============================================================================
# Platform — Observability (OTel -> SigNoz)
# ==============================================================================
OTEL_SERVICE_NAME=discord-backend
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318 # OTLP HTTP collector port (or 4317 for gRPC)
OTEL_TRACES_SAMPLER=always_on      # set to ratio_based in prod